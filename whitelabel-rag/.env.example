# Example environment variables for WhiteLabelRAG app
# Copy this file to .env and fill in the values before running the app

# Path to ChromaDB data directory
CHROMA_DB_PATH=./chromadb_data

# Google Gemini API key (required)
GEMINI_API_KEY=AIzaSyAI2FKSDrpRZTXjbeJpJOMNRKRE9y6ZY5Q

# Embedding model to use
EMBEDDING_MODEL=sentence-t5-base

# Maximum content length for uploads (in bytes)
MAX_CONTENT_LENGTH=16777216

# Flask environment (production or development)
FLASK_ENV=production

# Secret key for session security (generate your own)
# SECRET_KEY=your_secret_key_here

# Port to listen on (default 10000)
PORT=10000

# Log level (INFO, DEBUG, etc.)
LOG_LEVEL=INFO
